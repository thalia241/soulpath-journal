{
  "expo": {
    "name": "SoulPath Journal",
    "slug": "soulpath-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "soulpath",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.thalia241.soulpathjournal",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.thalia241.soulpathjournal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A18"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A18",
          "image": "./assets/splash-icon.png",
          "imageWidth": 145,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0C0A18",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a11d8975-5806-4829-994a-912a4a3effae"
      }
    }
  }
}
